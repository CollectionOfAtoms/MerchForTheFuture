# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is in .gitignore.
# Production values live in Vercel env vars only — see docs/pre-launch-runbook.md
# for the full production checklist.

# ── Database ──────────────────────────────────────────────────────────────────
# Neon pooled connection strings. DATABASE_URL_TEST is a separate Neon branch
# used by the Vitest suite (reset between test files — never point it at dev data).
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_TEST="postgresql://user:password@host-pooler.neon.tech/neondb_test?sslmode=require"

# ── Auth (NextAuth v5, credentials provider) ──────────────────────────────────
# Generate with: openssl rand -base64 32
# AUTH_SECRET is the v5 name; NEXTAUTH_SECRET kept in parallel for compatibility.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://localhost:3000"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Test-mode keys locally; live keys go in Vercel production env only.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Tax (Epic 5): leave false until dashboard tax registrations + origin
# address are configured. See docs/tax-configuration.md.
STRIPE_TAX_ENABLED="false"

# ── Apparel fulfillment (Teemill) ─────────────────────────────────────────────
# Key from https://teemill.com/api. Sent raw in the Authorization header (no
# "Bearer"); the ?project= param is derived from the key's JWT `sub` claim.
# No sandbox exists — tests use MSW; live calls hit the real API.
TEEMILL_API_KEY=""
# Optional overrides (defaults are correct):
# TEEMILL_PROJECT=""            # overrides the JWT-derived project id
# TEEMILL_API_BASE_URL=""       # default https://api.teemill.com/v1
# TEEMILL_SITE_URL=""           # default https://teemill.com

# ── Apparel fulfillment (Printful, Epic MFTF-18 — in discovery) ───────────────
# Printful v2 API (https://api.printful.com/v2). Bearer private token from the
# Printful dashboard. No sandbox — use a separate Printful test store for live
# checks; tests use MSW. See docs/printful-api-notes.md.
PRINTFUL_API_KEY=""
# Secret for verifying signed webhook payloads (set when subscribing the webhook).
PRINTFUL_WEBHOOK_SECRET=""
# Optional overrides:
# PRINTFUL_STORE_ID=""          # only if an account-level token needs X-PF-Store-Id
# PRINTFUL_API_BASE_URL=""      # default https://api.printful.com/v2

# ── Print fulfillment (Prodigi) ───────────────────────────────────────────────
# Use a sandbox key (starts with "test_") from dashboard.prodigi.com for local dev.
# Production key goes in Vercel env vars only — never commit it.
PRODIGI_API_KEY=""
# Defaults to the live API when unset. Set to sandbox for local dev and staging.
# Sandbox: https://api.sandbox.prodigi.com/v4.0
# Live:    https://api.prodigi.com/v4.0  (leave UNSET in production)
PRODIGI_API_BASE_URL="https://api.sandbox.prodigi.com/v4.0"

# ── Dropshipper order contact ─────────────────────────────────────────────────
# Forwarded to providers as the order contact (Teemill emails it) — must be a
# real, deliverable address on a domain you own.
DROPSHIPPING_CONTACT_EMAIL=""
# DROPSHIPPING_CONTACT_PHONE=""
# Logs raw provider request/response payloads — dev only, never in production.
# DROPSHIPPING_DEBUG="true"

# ── Email (MailerSend) ────────────────────────────────────────────────────────
MAILERSEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ── Image hosting (Vercel Blob) ───────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
# Optional separate public store; falls back to BLOB_READ_WRITE_TOKEN.
# BLOB_PUBLIC_READ_WRITE_TOKEN=""

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL used in transactional email links AND provider webhook callbacks
# (Prodigi callbacks self-address with it). Set to https://localhost:3000 for
# local dev; production sets the real domain in Vercel env vars.
NEXT_PUBLIC_BASE_URL="https://localhost:3000"
PLATFORM_FEE_PERCENT="10"
# Auction winner payment window (hours). Default 48.
# AUCTION_PAYMENT_WINDOW_HOURS="48"

# ── Cron auth ─────────────────────────────────────────────────────────────────
# Used to authenticate internal cron job requests. Generate with: openssl rand -hex 32
CRON_SECRET=""
